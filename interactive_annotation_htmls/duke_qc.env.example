# Duke vessel-annotation QC -- environment configuration.
#
# Copy this file to duke_qc.env, fill in the paths for your setup, then:
#     source interactive_annotation_htmls/duke_qc.env
# before running duke_qc_interactive.py / duke_qc_viz.py (the sbatch sources it
# automatically if present). duke_qc.env is gitignored -- never commit real paths.

# --- REQUIRED (differ per user / not public) --------------------------------

# Radiologist vessel annotations: the Duke supplement Segmentation_Masks_NRRD
# directory you downloaded from TCIA (see README.md for the download steps).
export DUKE_ANN_ROOT="/path/to/PKG - Duke-Breast-Cancer-MRI-Supplement-v3/Duke-Breast-Cancer-MRI-Supplement-v3/Segmentation_Masks_NRRD"

# Our vessel-probability segmentations (your pipeline output directory).
export DUKE_SEG_ROOT="/gpfs/data/karczmar-lab/workspaces/saritbose/vessel_segmentations/DUKE"

# Our extracted centerlines / skeletons (your pipeline output directory).
export DUKE_CL_ROOT="/gpfs/data/karczmar-lab/workspaces/saritbose/centerlines_tc4d/studies/DUKE"

# --- OPTIONAL (sensible defaults; uncomment only to override) ---------------

# MAMA-MIA source NIfTIs (shared team data; supplies the physical grid).
# export MAMA_MIA_IMAGES="/gpfs/data/karczmar-lab/MAMA-MIA-syn60868042/images"

# Where the interactive HTMLs are written (default: this directory).
# export DUKE_QC_INTERACTIVE_OUT="/path/to/output/htmls"

# Phase-A QC output (default: interactive_annotation_htmls/phaseA_qc).
# export DUKE_QC_OUT="/path/to/phaseA_qc"
