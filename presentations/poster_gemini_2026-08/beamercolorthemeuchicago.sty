% UChicago maroon colour theme for the gemini poster theme.
%
% A straight palette swap of beamercolorthemegemini.sty: every place gemini used
% one of its blues now uses the corresponding maroon. The filled regions stay
% filled -- the headline and footline are maroon, not white.
%
%   gemini blue      (64,115,158)  ->  maroon      (128,0,0)
%   gemini darkblue  (39,60,117)   ->  darkmaroon  (91,0,0)
%   gemini lightblue (232,244,255) ->  lightmaroon (250,236,236)

% ====================
% Definitions
% ====================

% UChicago maroon, #800000: https://news.uchicago.edu/brand-guidelines
\definecolor{maroon}{RGB}{128, 0, 0}
\definecolor{darkmaroon}{RGB}{91, 0, 0}
\definecolor{lightmaroon}{RGB}{250, 236, 236}
% Off-white, used for headline text and example-block fill (as in gemini)
\definecolor{lightgray}{RGB}{245, 246, 250}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=darkmaroon}

% Headline. The footline template reuses this colour, so both bars are maroon.
\setbeamercolor{headline}{fg=lightgray,bg=maroon}
\setbeamercolor{headline rule}{bg=darkmaroon}

% Block
\setbeamercolor{block title}{fg=maroon,bg=white}
\setbeamercolor{block separator}{bg=black}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=maroon,bg=lightmaroon}
\setbeamercolor{block alerted separator}{bg=black}
\setbeamercolor{block alerted body}{fg=black,bg=lightmaroon}

% Example Block
\setbeamercolor{block example title}{fg=maroon,bg=lightgray}
\setbeamercolor{block example separator}{bg=black}
\setbeamercolor{block example body}{fg=black,bg=lightgray}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=darkmaroon}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
\setbeamertemplate{bibliography entry article}{}
\setbeamertemplate{bibliography entry title}{}
\setbeamertemplate{bibliography entry location}{}
\setbeamertemplate{bibliography entry note}{}
