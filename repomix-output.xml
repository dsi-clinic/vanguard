            mip_status = "computed"
        except Exception as exc:
            mip_status = "failed"
            coverage_mip_diagnostics = {"error": str(exc)}
        mip_took = float(time.perf_counter() - t2)

    feature_qc = None if feature_stats is None else feature_stats.get("qc_counters")
    feature_qc_passed = (
