    def _cycle_length_mm(cycle_nodes: list[tuple[int, int, int]]) -> float:
        if len(cycle_nodes) < MIN_PATH_POINTS:
            return 0.0
        total = 0.0
        for i, u in enumerate(cycle_nodes):
