    --dependency="afterok:${ARRAY_JOB_ID}" \
    --cpus-per-task="${MERGE_CPUS}" \
    --mem="${MERGE_MEM}" \
    --time="${MERGE_TIME}" \
    --output="${REPO_ROOT}/logs/ml-ablation-merge-%j.out" \
    --error="${REPO_ROOT}/logs/ml-ablation-merge-%j.err" \
