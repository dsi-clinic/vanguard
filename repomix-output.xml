        }
      },
      "source": [
        "import numpy as np\n",
        "\n",
        "_MIN_MAX_PARTS = 2\n",
        "\n",
        "FIGURES_DIR = REPO_ROOT / \"analysis\" / \"issue121_figures\"\n",
        "\n",
        "RULE_DISPLAY_NAMES: dict[str, str] = {\n",
        "    \"local_radius_with_fallback\": \"Tumor rel.\\n+fallback\",\n",
        "    \"fixed_radius_30mm_with_fallback\": \"Fixed 30 mm\\n+fallback\",\n",
        "    \"fixed_radius_50mm_with_fallback\": \"Fixed 50 mm\\n+fallback\",\n",
        "    \"peritumoral_shells_with_fallback\": \"Peri ≤5 mm\\n+fallback\",\n",
        "    \"local_radius_only\": \"Tumor rel.\\nstrict\",\n",
        "    \"nearest_64_only\": \"Nearest\\n64 only\",\n",
        "}\n",
        "\n",
        "\n",
        "def _short_rule_labels(plot_df: pd.DataFrame) -> list[str]:\n",
        "    return [RULE_DISPLAY_NAMES.get(str(r), str(r)) for r in plot_df[\"inclusion_rule\"]]\n",
        "\n",
        "\n",
        "def _median_point_yerr(plot_df: pd.DataFrame) -> tuple[np.ndarray, np.ndarray]:\n",
        "    \"\"\"Lower/upper error bar lengths for median vs min–max from num_points_range.\"\"\"\n",
        "    medians = plot_df[\"num_points_median\"].to_numpy(dtype=float)\n",
        "    low = np.zeros_like(medians, dtype=float)\n",
        "    high = np.zeros_like(medians, dtype=float)\n",
        "    for idx in range(len(plot_df)):\n",
        "        row = plot_df.iloc[idx]\n",
        "        m = float(row[\"num_points_median\"])\n",
        "        parts = str(row[\"num_points_range\"]).split(\"-\", 1)\n",
        "        if len(parts) == _MIN_MAX_PARTS:\n",
        "            try:\n",
        "                lo = int(parts[0])\n",
        "                hi = int(parts[1])\n",
        "                low[idx] = max(0.0, m - float(lo))\n",
        "                high[idx] = max(0.0, float(hi) - m)\n",
        "            except ValueError:\n",
        "                low[idx] = np.nan\n",
        "                high[idx] = np.nan\n",
        "        else:\n",
        "            low[idx] = np.nan\n",
        "            high[idx] = np.nan\n",
        "    return low, high\n",
        "\n",
        "\n",
        "def _slug_from_title(title: str) -> str:\n",
        "    safe = \"\".join(ch if ch.isalnum() else \"_\" for ch in title.lower())\n",
        "    while \"__\" in safe:\n",
        "        safe = safe.replace(\"__\", \"_\")\n",
        "    return safe.strip(\"_\")[:80] or \"issue121_plot\"\n",
        "\n",
        "\n",
        "def plot_summary(df: pd.DataFrame, title: str) -> None:\n",
        "    \"\"\"Plot inclusion-rule comparison bars for a summary table.\"\"\"\n",
        "    plot_df = df.copy().reset_index(drop=True)\n",
        "    x = np.arange(len(plot_df), dtype=float)\n",
        "    labels = _short_rule_labels(plot_df)\n",
        "    fig, axes = plt.subplots(2, 2, figsize=(12, 7), constrained_layout=True)\n",
        "    ax0, ax1, ax2, ax3 = axes.ravel()\n",
        "\n",
        "    ax0.bar(x, plot_df[\"cases_written\"], color=\"#1f77b4\")\n",
        "    ax0.set_xticks(x, labels)\n",
        "    ax0.set_title(\"Cases written\")\n",
        "    ax0.set_ylabel(\"Cases\")\n",
        "\n",
        "    ax1.bar(x, plot_df[\"cases_skipped\"], color=\"#d62728\")\n",
        "    ax1.set_xticks(x, labels)\n",
        "    ax1.set_title(\"Cases skipped\")\n",
        "    ax1.set_ylabel(\"Cases\")\n",
        "\n",
        "    ax2.bar(x, plot_df[\"fallback_fraction\"], color=\"#2ca02c\")\n",
        "    ax2.set_xticks(x, labels)\n",
        "    ax2.set_title(\"Fallback fraction\")\n",
        "    ax2.set_ylabel(\"Fraction of written cases\")\n",
        "    ax2.set_ylim(0.0, max(0.05, float(plot_df[\"fallback_fraction\"].max()) * 1.15))\n",
        "\n",
        "    med = plot_df[\"num_points_median\"].to_numpy(dtype=float)\n",
        "    ylo, yhi = _median_point_yerr(plot_df)\n",
        "    ax3.bar(\n",
        "        x,\n",
        "        med,\n",
        "        color=\"#9467bd\",\n",
        "        yerr=np.vstack([ylo, yhi]),\n",
        "        capsize=3,\n",
        "        ecolor=\"#333333\",\n",
        "    )\n",
        "    ax3.set_xticks(x, labels)\n",
        "    ax3.set_title(\"Median num_points (min–max whiskers)\")\n",
        "    ax3.set_ylabel(\"Point count\")\n",
        "\n",
        "    fig.suptitle(title)\n",
        "\n",
        "    FIGURES_DIR.mkdir(parents=True, exist_ok=True)\n",
        "    out_path = FIGURES_DIR / f\"{_slug_from_title(title)}.png\"\n",
        "    fig.savefig(out_path, dpi=180, bbox_inches=\"tight\")\n",
        "    print(f\"Saved figure: {out_path}\")\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "if fixture_df is not None:\n",
        "    plot_summary(fixture_df, \"Issue #121 fixture inclusion-rule comparison\")\n",
        "\n",
        "if cohort_df is not None:\n",
        "    plot_summary(cohort_df, \"Issue #121 cohort inclusion-rule comparison\")"
      ],
