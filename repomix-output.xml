            if edge_weight_graph.has_edge(u, v):
                total += float(edge_weight_graph[u][v].get("weight_mm", 0.0))
            else:
                dxyz = np.asarray(
                    [
                        (float(v[0]) - float(u[0])) * sx,
                        (float(v[1]) - float(u[1])) * sy,
                        (float(v[2]) - float(u[2])) * sz,
                    ],
