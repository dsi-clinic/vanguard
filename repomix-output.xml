            ax.scatter(
                Z[m1, 0],
                Z[m1, 1],
                c=[c],
                marker="^",
                alpha=0.5,
                s=25,
                label=f"{site} (pCR=1)",
            )

        ax.set_xlim(xlim)
        ax.set_ylim(ylim)
        ax.set_xlabel(f"PC1 ({pca.explained_variance_ratio_[0]:.1%})")
        ax.set_ylabel(f"PC2 ({pca.explained_variance_ratio_[1]:.1%})")
        ax.set_title(title)

    # Shared legend
    handles = []
    for si, site in enumerate(unique_sites):
        c = colors[si % len(colors)]
        handles.append(
            Line2D(
                [0],
                [0],
                marker="o",
                color="w",
                markerfacecolor=c,
