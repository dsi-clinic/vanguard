    "### Loading Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "metadata": {},
   "outputs": [],
   "source": [
    "logger = logging.getLogger(__name__)\n",
    "if not logger.handlers:\n",
    "    handler = logging.StreamHandler()\n",
    "    handler.setLevel(logging.INFO)\n",
    "    logger.addHandler(handler)\n",
    "logger.setLevel(logging.INFO)\n",
    "\n",
    "\n",
    "def load_data(json_dir: str) -> pd.DataFrame:\n",
    "    \"\"\"Load per-patient JSONs from `json_dir` into a tidy DataFrame with normalized fields.\"\"\"\n",
    "    rows: list[dict[str, Any]] = []\n",
    "    p = Path(json_dir)\n",
    "    files = sorted(p.glob(\"*.json\"))\n",
    "    for f in files:\n",
    "        try:\n",
    "            with f.open() as fh:\n",
    "                js = json.load(fh)\n",
    "        except Exception as exc:\n",
    "            logger.warning(\"Skipping %s due to error: %s\", f, exc, exc_info=True)\n",
    "            continue\n",
    "\n",
    "        row = {\n",
    "            \"patient_id\": get_patient_id(f, js),\n",
    "            \"site\": get_site(js),\n",
    "            \"dataset\": get_dataset(js),\n",
    "            \"age\": get_age(js),\n",
    "            \"menopausal\": get_menopausal(js),\n",
    "            \"breast_density\": get_breast_density(js),\n",
    "            \"laterality\": get_laterality(js),\n",
    "            \"bbox_volume\": get_bbox_volume(js),\n",
    "            \"field_strength\": get_field_strength(js),\n",
    "            \"manufacturer\": get_manufacturer(js),\n",
    "            \"model\": get_model(js),\n",
    "            \"echo_time\": get_echo_time(js),\n",
    "            \"repetition_time\": get_repetition_time(js),\n",
    "        }\n",
    "        rows.append(row)\n",
    "\n",
    "    df = pd.DataFrame(rows)  # noqa: PD901  (keep 'df' for downstream notebook cells)\n",
    "    return df"
   ]
  },
