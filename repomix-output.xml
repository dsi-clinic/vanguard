import yaml
from pathlib import Path
conf = yaml.safe_load(Path("${CONFIG}").read_text())
print(int(conf["model_params"].get("n_splits", 5)))
PY
)"

N_ARMS="$(
  "${ENV_PYTHON}" - <<PY
import yaml
from pathlib import Path
conf = yaml.safe_load(Path("${CONFIG}").read_text())
print(len(conf.get("ablation_arms") or []))
PY
)"

if [[ "${N_ARMS}" -le 0 ]]; then
  echo "No ablation_arms defined in ${CONFIG}" >&2
