# cwd REPO_ROOT, so passing a bare ../experiments/... CONFIG breaks there.
_resolve_out_root() {
  local out="$1"
  if [[ "${out}" != /* ]]; then
    ( cd "${SCRIPT_DIR}" && mkdir -p "${out}" && cd "${out}" && pwd )
