   "source": [
    "### Parsing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_patient_id(path: Path, js: dict[str, Any]) -> str:\n",
    "    \"\"\"Return explicit `patient_id` if present; otherwise fall back to filename stem.\"\"\"\n",
    "    return js.get(\"patient_id\", path.stem)\n",
    "\n",
    "\n",
    "def get_site(js: dict[str, Any]) -> str:\n",
    "    \"\"\"Extract imaging site as UPPER string; 'UNKNOWN' if unavailable.\"\"\"\n",
    "    site = js.get(\"imaging_data\", {}).get(\"site\", \"\")\n",
    "    return str(site).strip().upper() if site else \"UNKNOWN\"\n",
    "\n",
    "\n",
    "def get_dataset(js: dict[str, Any]) -> str:\n",
    "    \"\"\"Extract dataset name as UPPER string; 'UNKNOWN' if unavailable.\"\"\"\n",
    "    ds = js.get(\"imaging_data\", {}).get(\"dataset\", None)\n",
    "    return str(ds).strip().upper() if ds else \"UNKNOWN\"\n",
    "\n",
    "\n",
    "def get_age(js: dict[str, Any]) -> float | None:\n",
    "    \"\"\"Return age (float) from clinical_data; None if missing.\"\"\"\n",
    "    age = js.get(\"clinical_data\", {}).get(\"age\", None)\n",
    "    try:\n",
    "        return float(age) if age is not None else None\n",
    "    except (TypeError, ValueError):\n",
    "        return None\n",
    "\n",
    "\n",
    "def get_menopausal(js: dict[str, Any]) -> str:\n",
    "    \"\"\"Normalize menopausal status to {'pre', 'post', 'unknown'}.\"\"\"\n",
    "    raw = js.get(\"clinical_data\", {}).get(\"menopausal_status\", \"\")\n",
    "    s = str(raw).strip().lower()\n",
    "    if not s:\n",
    "        return \"unknown\"\n",
    "    if \"pre\" in s:\n",
    "        return \"pre\"\n",
    "    if \"post\" in s:\n",
    "        return \"post\"\n",
    "    return \"unknown\"\n",
    "\n",
    "\n",
    "def get_breast_density(js: dict[str, Any]) -> str:\n",
    "    \"\"\"Return BI-RADS breast density category as a lowercase string if present; else 'unknown'.\"\"\"\n",
    "    raw = js.get(\"clinical_data\", {}).get(\"breast_density\", \"\")\n",
    "    return str(raw).strip().lower() if raw else \"unknown\"\n",
    "\n",
    "\n",
    "def get_laterality(js: dict[str, Any]) -> str:\n",
    "    \"\"\"Return 'bilateral' if flagged, else left/right/unknown from imaging_data.\"\"\"\n",
    "    bil = js.get(\"imaging_data\", {}).get(\"bilateral\", None)\n",
    "    if bil is True:\n",
    "        return \"bilateral\"\n",
    "    lat = js.get(\"imaging_data\", {}).get(\"laterality\", \"\")\n",
    "    s = str(lat).strip().lower()\n",
    "    return s if s else \"unknown\"\n",
    "\n",
    "\n",
    "def get_bbox_volume(js: dict[str, Any]) -> float | None:\n",
    "    \"\"\"Compute primary lesion bounding-box volume if coordinates present; else None.\"\"\"\n",
    "    bc = js.get(\"primary_lesion\", {}).get(\"breast_coordinates\", {})\n",
    "    try:\n",
    "        w = float(bc.get(\"width\", 0))\n",
    "        h = float(bc.get(\"height\", 0))\n",
    "        d = float(bc.get(\"depth\", 0))\n",
    "        vol = w * h * d\n",
    "        return vol if vol > 0 else None\n",
    "    except (TypeError, ValueError):\n",
    "        return None\n",
    "\n",
    "\n",
    "def get_field_strength(js: dict[str, Any]) -> float | None:\n",
    "    \"\"\"Return MRI field strength (Tesla) as float; None if missing.\"\"\"\n",
    "    val = js.get(\"imaging_data\", {}).get(\"field_strength\", None)\n",
    "    return float(val) if val is not None else None\n",
    "\n",
    "\n",
    "def get_manufacturer(js: dict[str, Any]) -> str:\n",
    "    \"\"\"Return scanner manufacturer as trimmed string; 'unknown' if missing.\"\"\"\n",
    "    val = js.get(\"imaging_data\", {}).get(\"scanner_manufacturer\", \"\")\n",
    "    return str(val).strip() if val else \"unknown\"\n",
    "\n",
    "\n",
    "def get_model(js: dict[str, Any]) -> str:\n",
    "    \"\"\"Return scanner model as trimmed string; 'unknown' if missing.\"\"\"\n",
    "    val = js.get(\"imaging_data\", {}).get(\"scanner_model\", \"\")\n",
    "    return str(val).strip() if val else \"unknown\"\n",
    "\n",
    "\n",
    "def get_echo_time(js: dict[str, Any]) -> float | None:\n",
    "    \"\"\"Return echo time (ms) as float; None if missing.\"\"\"\n",
    "    val = js.get(\"imaging_data\", {}).get(\"echo_time\", None)\n",
    "    return float(val) if val is not None else None\n",
    "\n",
    "\n",
    "def get_repetition_time(js: dict[str, Any]) -> float | None:\n",
    "    \"\"\"Return repetition time (ms) as float; None if missing.\"\"\"\n",
    "    val = js.get(\"imaging_data\", {}).get(\"repetition_time\", None)\n",
    "    return float(val) if val is not None else None"
   ]
  },
