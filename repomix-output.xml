   "source": [
    "## Per-subtype validation (`validation_summary`)\n",
    "\n",
    "Each completed run’s `metrics.json` includes `validation_summary`: **pooled** validation metrics over all OOF predictions, with `overall` plus `by_group` keyed by `tumor_subtype` (from the manifest). ISPY2 arms typically report `her2_enriched`, `luminal_a`, `luminal_b`, and `triple_negative`.\n",
    "\n",
    "The plots below compare **overall** vs **HER2-enriched** AUC per arm and show the full subtype × arm grid as a heatmap."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "0bbd9b6a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved: /home/lunad/vanguard-issue120-benchmark/analysis/figures/deepsets_issue120/subtype_validation_long.csv\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x450 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved: /home/lunad/vanguard-issue120-benchmark/analysis/figures/deepsets_issue120/validation_auc_overall_vs_her2_enriched.png\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x515 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved: /home/lunad/vanguard-issue120-benchmark/analysis/figures/deepsets_issue120/validation_auc_subtype_heatmap.png\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "\n",
    "HER2_SUBTYPE_KEY = \"her2_enriched\"\n",
    "\n",
    "subtype_rows: list[dict] = []\n",
    "overall_rows: list[dict] = []\n",
    "for _, r in metrics_df.iterrows():\n",
    "    if r[\"status\"] != \"found\":\n",
    "        continue\n",
    "    mp_raw = str(r.get(\"metrics_path\", \"\") or \"\").strip()\n",
    "    if not mp_raw:\n",
    "        continue\n",
    "    mp = Path(mp_raw)\n",
    "    if not mp.is_file():\n",
    "        continue\n",
    "    payload = json.loads(mp.read_text(encoding=\"utf-8\"))\n",
    "    vs = payload.get(\"validation_summary\") or {}\n",
    "    overall_auc = (vs.get(\"overall\") or {}).get(\"auc\")\n",
    "    overall_rows.append(\n",
    "        {\n",
    "            \"arm\": r[\"arm\"],\n",
    "            \"regime\": r[\"regime\"],\n",
    "            \"out_root\": r[\"out_root\"],\n",
    "            \"overall_pooled_auc\": overall_auc,\n",
    "        }\n",
    "    )\n",
    "    for st, m in (vs.get(\"by_group\") or {}).items():\n",
    "        subtype_rows.append(\n",
    "            {\n",
    "                \"arm\": r[\"arm\"],\n",
    "                \"regime\": r[\"regime\"],\n",
    "                \"out_root\": r[\"out_root\"],\n",
    "                \"subtype\": str(st),\n",
    "                \"auc\": m.get(\"auc\"),\n",
    "                \"ap\": m.get(\"ap\"),\n",
    "            }\n",
    "        )\n",
    "\n",
    "subtype_benchmark_df = pd.DataFrame(subtype_rows)\n",
    "overall_df = pd.DataFrame(overall_rows)\n",
    "\n",
    "if not subtype_benchmark_df.empty:\n",
    "    subtype_csv = FIG_DIR / \"subtype_validation_long.csv\"\n",
    "    subtype_benchmark_df.to_csv(subtype_csv, index=False)\n",
    "    print(f\"Saved: {subtype_csv}\")\n",
    "\n",
    "if subtype_benchmark_df.empty:\n",
    "    print(\n",
    "        \"No per-subtype data: metrics.json files lack validation_summary.by_group \"\n",
    "        \"(stratum column missing in manifest or older evaluator output).\"\n",
    "    )\n",
    "else:\n",
    "    her2_slice = subtype_benchmark_df.loc[\n",
    "        subtype_benchmark_df[\"subtype\"].str.lower() == HER2_SUBTYPE_KEY.lower()\n",
    "    ]\n",
    "    combo = overall_df.merge(\n",
    "        her2_slice[[\"arm\", \"auc\"]].rename(columns={\"auc\": \"her2_enriched_auc\"}),\n",
    "        on=\"arm\",\n",
    "        how=\"left\",\n",
    "    )\n",
